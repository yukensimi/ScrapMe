# Exact comma-separated origins allowed to call the ScrapMe proxy.
# Development also permits localhost:3000 and 127.0.0.1:3000 by default.
# In production, set this to the exact public ScrapMe origin(s), e.g. https://scrapme.example.com
SCRAPME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
